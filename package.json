{
  "name": "waygoal",
  "version": "0.1.0-alpha.4",
  "description": "Waygoal — a local canvas for conversations and exploration",
  "homepage": "https://github.com/s0ftnote/Waygoal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s0ftnote/Waygoal.git"
  },
  "bugs": {
    "url": "https://github.com/s0ftnote/Waygoal/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-terminal.js",
    "dev": "WAYGOAL=1 next dev -H 127.0.0.1 -p 30142",
    "build": "next build --webpack",
    "start": "WAYGOAL=1 next start -H 127.0.0.1 -p 30142",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test:terminal": "node tests/e2e/terminal.mjs",
    "test:e2e": "node tests/e2e/waygoal-all.mjs",
    "test:waygoal": "node tests/e2e/waygoal.mjs",
    "test:waygoal-all": "node tests/e2e/waygoal-all.mjs",
    "test:waygoal-takeaways": "node tests/e2e/waygoal-takeaways.mjs",
    "test:waygoal-sibling-forks": "node tests/e2e/waygoal-sibling-forks.mjs",
    "test:waygoal-panel-bounds": "node tests/e2e/waygoal-panel-bounds.mjs",
    "test:waygoal-branches": "node tests/e2e/waygoal-branches.mjs",
    "test:waygoal-exploration": "node tests/e2e/waygoal-exploration.mjs",
    "test:waygoal-review": "node tests/e2e/waygoal-review.mjs",
    "test:waygoal-tickets": "node tests/e2e/waygoal-tickets.mjs",
    "test:waygoal-dependencies": "node tests/e2e/waygoal-dependencies.mjs",
    "test:waygoal-find": "node tests/e2e/waygoal-find.mjs",
    "test:waygoal-workspaces": "node tests/e2e/waygoal-workspaces.mjs",
    "test:waygoal-ticket-talks": "node tests/e2e/waygoal-ticket-talks.mjs",
    "test:waygoal-map": "node tests/e2e/waygoal-map.mjs",
    "test:waygoal-groups": "node tests/e2e/waygoal-groups.mjs",
    "test:waygoal-remote": "node tests/e2e/waygoal-remote.mjs",
    "test": "node --experimental-strip-types --test \"src/**/*.test.mjs\" \"tests/config/*.test.mjs\" \"public/**/*.test.mjs\"",
    "test:waygoal-rename-lineage": "node tests/e2e/waygoal-rename-lineage.mjs",
    "setup": "npm ci",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:chat": "node tests/e2e/run.mjs",
    "prototype:canvas": "python3 -m http.server 30145 --bind 127.0.0.1 --directory experiments"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ansi_up": "^6.0.6",
    "js-yaml": "^5.2.3",
    "next": "16.3.1",
    "node-pty": "1.2.0-beta.15",
    "proper-lockfile": "4.1.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remark-frontmatter": "^5.0.0",
    "semver": "7.8.0",
    "undici": "8.10.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/semver": "7.8.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5"
  },
  "private": true
}
